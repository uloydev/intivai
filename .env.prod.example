# Production secrets checklist — copy to .env.prod on the server, NEVER commit.
# Every value must be set; the app refuses to boot without JWT_SECRET and fails
# honestly (failed_extract) without the DeepSeek key.

# --- App ---
INTIVAI_APP_PORT=8080
INTIVAI_ENV=prod
# Comma-separated origins allowed by CORS + the WS origin allowlist (CSWSH).
# MUST include the deployed origin, e.g. https://intivai.example.com
INTIVAI_ALLOWED_ORIGINS=https://intivai.example.com
INTIVAI_APP_PUBLIC_URL=https://intivai.example.com

# --- Database (least privilege: the intivai_app role created by migration 002) ---
# Migration 002 creates intivai_app with password 'intivai_app'. For real
# prod, change it after the first migrate:
#   docker exec -i intivai-postgres-1 psql -U intivai -d intivai #     -c "ALTER ROLE intivai_app PASSWORD '<strong>'"
# …then put the same value here.
INTIVAI_DATABASE_URL=postgres://intivai_app:intivai_app@postgres:5432/intivai?sslmode=disable
# Admin URL — used ONLY by the migrate service (-migrate-only).
INTIVAI_MIGRATE_URL=postgres://intivai:CHANGE_ME@postgres:5432/intivai?sslmode=disable

# --- Postgres superuser (docker-compose.prod.yml postgres service) ---
POSTGRES_PASSWORD=CHANGE_ME

# --- Redis ---
INTIVAI_REDIS_ADDR=redis:6379

# --- MinIO (must match the MINIO_ROOT_* values below) ---
INTIVAI_MINIO_ENDPOINT=minio:9000
INTIVAI_MINIO_ACCESS_KEY=intivai
INTIVAI_MINIO_SECRET_KEY=CHANGE_ME
INTIVAI_MINIO_BUCKET=intivai
INTIVAI_MINIO_USE_SSL=false

# --- Auth ---
INTIVAI_JWT_SECRET=CHANGE_ME_long_random
INTIVAI_JWT_EXPIRY_HRS=12
INTIVAI_BCRYPT_COST=12

# --- LLM ---
INTIVAI_DEEPSEEK_API_KEY=sk-...
INTIVAI_DEEPSEEK_BASE_URL=https://api.deepseek.com
INTIVAI_DEEPSEEK_MODEL=deepseek-chat
INTIVAI_LLM_MAX_RETRIES=3

# --- Memory (pgvector bank = production path) ---
INTIVAI_MEMORY_DRIVER=postgres
INTIVAI_MEMORY_DATA_DIR=/data
# Optional: local embeddings (model downloads to /data/models on first use)
# INTIVAI_EMBEDDINGS_ENABLED=true
# INTIVAI_EMBED_MODEL_DIR=/data/models

# --- Rate limits (tune for real traffic) ---
INTIVAI_RATE_LIMIT_AUTH_PER_MIN=10
INTIVAI_RATE_LIMIT_TENANT_PER_MIN=1000
INTIVAI_RATE_LIMIT_USER_PER_MIN=100

# --- Error reporting (optional; no-op when empty) ---
# INTIVAI_SENTRY_DSN=https://...

# --- SMTP (real mailer; REQUIRED — the app refuses prod boot without these) ---
INTIVAI_SMTP_HOST=CHANGE_ME
INTIVAI_SMTP_PORT=587
INTIVAI_SMTP_USER=CHANGE_ME
INTIVAI_SMTP_PASS=CHANGE_ME
INTIVAI_SMTP_FROM="Intivai Talent <no-reply@intivai.example.com>"

# --- Offsite backup copy (scripts/backup.sh; DR hard gate 2026-09-30) ---
# Leave unset for local-only backups; enable DR with either:
#   OFFSITE_DEST='b2:intivai-backups/prod/'   (rclone remote:path)
#   OFFSITE_DEST='s3://bucket/intivai-backups/' (aws s3)
# OFFSITE_DEST=

# --- MinIO server root creds (docker-compose.prod.yml minio service) ---
MINIO_ROOT_USER=intivai
MINIO_ROOT_PASSWORD=CHANGE_ME

# --- Deploy notes ---
# Compose commands MUST pass --env-file .env.prod (base compose environment
# would otherwise win and boot with dev secrets):
#   docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml up -d
# Frontend: CI builds frontend/dist and ships it to /opt/intivai/frontend/dist
# (mounted into Caddy at /srv/frontend). Backups: nightly cron
#   scripts/backup.sh (pg_dump + MinIO mirror, 14-day retention); restore via
#   scripts/restore.sh. Rollback: redeploy the previous TAG (image sha).
INTIVAI_SANDBOX_SIDECAR_ADDR=sandbox-sidecar:8443
INTIVAI_SANDBOX_CA_CERT=/sandbox-certs/ca.pem
INTIVAI_SANDBOX_CLIENT_CERT=/sandbox-certs/client.pem
INTIVAI_SANDBOX_CLIENT_KEY=/sandbox-certs/client-key.pem
