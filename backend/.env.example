# --- Intivai backend environment ---
# Copy to .env and adjust. All vars prefixed INTIVAI_ via Viper.

INTIVAI_APP_PORT=8080
INTIVAI_ENV=dev
INTIVAI_ALLOWED_ORIGINS=http://localhost:3000

# Postgres (+ pgvector). Must include pgx sslmode as needed.
# App connects as least-privilege role (created by migration 002). RLS
# policies are enforced for this role — never use a superuser here.
INTIVAI_DATABASE_URL=postgres://intivai_app:intivai_app@localhost:5432/intivai?sslmode=disable

# Admin URL — used ONLY by `./server -migrate-only` (or the compose migrate
# service). Superuser/owner privileges required (creates roles + FORCE RLS).
INTIVAI_MIGRATE_URL=postgres://intivai:intivai@localhost:5432/intivai?sslmode=disable

# Redis (queue + rate limit + cache)
INTIVAI_REDIS_ADDR=localhost:6379

# MinIO (S3-compatible file storage)
INTIVAI_MINIO_ENDPOINT=localhost:9000
INTIVAI_MINIO_ACCESS_KEY=intivai
INTIVAI_MINIO_SECRET_KEY=intivai123
INTIVAI_MINIO_BUCKET=intivai
INTIVAI_MINIO_USE_SSL=false

# Auth
INTIVAI_JWT_SECRET=change-me-in-prod
INTIVAI_JWT_EXPIRY_HRS=12
INTIVAI_WS_TICKET_MINS=10
INTIVAI_BCRYPT_COST=10

# LLM (DeepSeek primary)
INTIVAI_DEEPSEEK_API_KEY=
INTIVAI_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
INTIVAI_DEEPSEEK_MODEL=deepseek-chat
INTIVAI_LLM_MAX_RETRIES=3
# Optional OpenAI-compatible fallback
# INTIVAI_LLM_FALLBACK_BASE_URL=
# INTIVAI_LLM_FALLBACK_API_KEY=

# Semantic memory (sqlite | postgres — postgres = prod/pgvector bank)
INTIVAI_MEMORY_DRIVER=sqlite
INTIVAI_MEMORY_DATA_DIR=./data

# Rate limits (per minute)
INTIVAI_RATE_LIMIT_TENANT_PER_MIN=1000
INTIVAI_RATE_LIMIT_USER_PER_MIN=100
INTIVAI_RATE_LIMIT_AUTH_PER_MIN=10

# CV uploads
INTIVAI_CV_MAX_UPLOAD_MB=10
