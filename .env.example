# Dev-stack environment — copy to .env and fill your own values.
# This file is the LOCAL dev stack config (Makefile COMPOSE targets use
# --env-file .env). NEVER commit .env (live API keys live here).
# Production: .env.prod (git-ignored, seeded from .env.prod.example).
# CI: .env.ci (tracked, non-secret).
#
# Every var below is read by the app (pkg/config) AND relayed by
# docker-compose.yml/dev. Keep in sync — scripts/check-env-sync.sh
# verifies: (a) nothing here is dead (consumed by app or compose),
# (b) every compose-relayed dev var is declared here with a value.
# Re-run after adding a var: docker compose config >/dev/null

# LLM (required for interviews/eval; empty = honest failed_extract path)
INTIVAI_LLM_API_KEY=
# OpenAI-compatible endpoint (OpenRouter in local .env example)
INTIVAI_LLM_BASE_URL=https://ai.sumopod.com/v1
INTIVAI_LLM_MODEL=MiniMax-M2.7-highspeed
INTIVAI_LLM_PROVIDER_NAME=sumopod
# Overrides config default 60s — reasoning models need more
INTIVAI_LLM_TIMEOUT_SECONDS=180

# Browser origins allowed through CORS + WS CSWSH (hat tip: FE dev server
# proxies WS on /api; the FE origin MUST appear here or the chat socket
# handshake is rejected)
INTIVAI_ALLOWED_ORIGINS=http://localhost:5173

# Tracing: dev overlay flips OTEL_ENABLE=true and pins sampling 1.0
# (docker-compose.dev.yml). Keep false for a quieter local stack unless
# actively inspecting spans in Jaeger (http://localhost:16686).
INTIVAI_OTEL_ENABLE=false
INTIVAI_OTEL_TRACES_SAMPLER_ARG=1
