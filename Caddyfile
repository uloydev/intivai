# Intivai — Caddy reverse proxy + static frontend (TLS auto via Let's Encrypt).
# The site address interpolates $DOMAIN (set in .env.prod); falls back to
# intivai.example.com. Frontend build ships to ./frontend/dist (see CI deploy).
{$DOMAIN:intivai.example.com} {
	# Security headers on the whole site (HSTS + clickjacking/MIME sniffing).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# API + WebSocket (chat) → Go app. Caddy handles the WS upgrade.
	handle /api/* {
		reverse_proxy app:8080
	}

	# Static SPA; hashed assets are immutable — cache them hard. The HTML
	# shell is never cached (its asset references change every deploy), and
	# client-side routes (invite links, /candidates, /interviews/:id) fall
	# back to index.html so deep links and refreshes don't 404.
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
		@hashed path *.js *.css *.png *.svg *.woff2 *.ico
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@index path /index.html
		header @index Cache-Control "no-cache"
	}
}
