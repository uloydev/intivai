# Intivai — Caddy reverse proxy + static frontend (TLS auto via Let's Encrypt).
# Replace intivai.example.com with the real domain before first deploy.
# Frontend build ships to ./frontend/dist (see CI deploy job).
intivai.example.com {
	# API + WebSocket (chat) → Go app. Caddy handles the WS upgrade.
	handle /api/* {
		reverse_proxy app:8080
	}

	# Static SPA; hashed assets are immutable — cache them hard. The HTML
	# shell is never cached (its asset references change every deploy), and
	# client-side routes (invite links, /candidates, /interviews/:id) fall
	# back to index.html so deep links and refreshes don't 404.
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
		@hashed path *.js *.css *.png *.svg *.woff2 *.ico
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@index path /index.html
		header @index Cache-Control "no-cache"
	}
}
